// Inventory service: extracts traceparent, records a server span
// plus a simulated-DB child span, exports both to Jaeger.
import http
import process
import self.otel

effect fn handle(t: otel.Tracer, req: HttpRequest) -> String = {
  let parent = otel.parse_traceparent(http.req_header(req, "traceparent") ?? "")
  let span0 = otel.start_span(t, parent, "GET /inventory", otel.KIND_SERVER)!
  let span = otel.with_attr(span0, "http.method", http.req_method(req))

  let db0 = otel.start_span(t, some(otel.ctx(span)), "SELECT items", otel.KIND_INTERNAL)!
  process.sleep(25)  // simulated DB latency
  let db = otel.end_span(t, otel.with_attr(db0, "db.system", "sqlite"))!

  let done = otel.end_span(t, span)!
  let _ = otel.export(t, [done, db])!
  "{\"items\": [\"potion\", \"elixir\"], \"trace\": \"${done.trace_id}\"}"
}

effect fn main() -> Unit = {
  let t = otel.tracer("almide-inventory", "http://localhost:4318/v1/traces")!
  println("inventory service listening on http://localhost:7002")
  http.serve(7002, (req) =>
    match handle(t, req) {
      ok(body) => http.json(200, body),
      err(e) => http.json(500, "{\"error\": \"${e}\"}"),
    })
}
