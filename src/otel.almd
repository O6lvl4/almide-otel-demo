// Minimal OpenTelemetry tracing SDK for Almide.
// Traces only. Export: OTLP/HTTP + JSON (proto3 JSON mapping).
// Context propagation: W3C Trace Context (traceparent header).
import json
import http
import random

// The five OTLP span kinds. `kind_code` maps to the wire enum —
// the full matrix, matching opentelemetry-proto's SpanKind.
type SpanKind = Internal | Server | Client | Producer | Consumer

fn kind_code(k: SpanKind) -> Int =
  match k {
    Internal => 1,
    Server   => 2,
    Client   => 3,
    Producer => 4,
    Consumer => 5,
  }

type Tracer = {
  service: String,
  endpoint: String,
  // wall-clock ns at monotonic zero: anchor once, derive all span
  // timestamps from the monotonic clock (same trick as real SDKs —
  // datetime.now() is second-precision, monotonic_ns() fills the gap)
  anchor: Int,
}

type SpanCtx = { trace_id: String, span_id: String }

type Span = {
  trace_id: String,
  span_id: String,
  parent_span_id: Option[String],  // none = root
  name: String,
  kind: SpanKind,
  start_ns: Int,
  end_ns: Int,
  attrs: List[(String, String)],
}

effect fn tracer(service: String, endpoint: String) -> Tracer = {
  let anchor = datetime.now() * 1_000_000_000 - datetime.monotonic_ns()
  Tracer { service: service, endpoint: endpoint, anchor: anchor }
}

effect fn rand_hex(n_bytes: Int) -> String =
  list.range(0, n_bytes)
    |> list.map((_) => random.int(0, 255))
    |> bytes.from_list
    |> hex.encode

effect fn now_ns(t: Tracer) -> Int = t.anchor + datetime.monotonic_ns()

// parent = none → new root span (fresh trace_id)
// parent = some(ctx) → child span in the same trace
effect fn start_span(t: Tracer, parent: Option[SpanCtx], name: String, kind: SpanKind) -> Span = {
  let fresh_tid = rand_hex(16)!
  let sid = rand_hex(8)!
  let ts = now_ns(t)!
  let tid = match parent { some(c) => c.trace_id, none => fresh_tid }
  let pid = match parent { some(c) => some(c.span_id), none => none }
  Span {
    trace_id: tid,
    span_id: sid,
    parent_span_id: pid,
    name: name,
    kind: kind,
    start_ns: ts,
    end_ns: 0,
    attrs: [],
  }
}

effect fn end_span(t: Tracer, s: Span) -> Span = {
  let ts = now_ns(t)!
  { ...s, end_ns: ts }
}

fn with_attr(s: Span, key: String, val: String) -> Span =
  { ...s, attrs: s.attrs + [(key, val)] }

fn ctx(s: Span) -> SpanCtx =
  SpanCtx { trace_id: s.trace_id, span_id: s.span_id }

// ── W3C Trace Context ──

fn traceparent(s: Span) -> String = "00-${s.trace_id}-${s.span_id}-01"

fn parse_traceparent(h: String) -> Option[SpanCtx] = {
  let parts = string.split(h, "-")
  let tid = list.get(parts, 1) ?? ""
  let sid = list.get(parts, 2) ?? ""
  if list.len(parts) == 4 and string.len(tid) == 32 and string.len(sid) == 16
  then some(SpanCtx { trace_id: tid, span_id: sid })
  else none
}

// ── OTLP/HTTP JSON encoding ──
// Wire-mirror record types: field names ARE the OTLP wire names, so the
// derived Codec produces the document and the only hand-written logic is
// the Span→wire transform (kind code, nanos-as-string per the proto3 JSON
// mapping for fixed64). A none Option field OMITS its key — exactly proto3
// "unset" — so parentSpanId on a root span and the AnyValue oneof both fall
// out of the type shape with no special casing.

type OtlpAttrValue: Codec = {
  stringValue: Option[String] = none,
  intValue: Option[String] = none,    // proto3 JSON: int64 rides as string
  boolValue: Option[Bool] = none,
  doubleValue: Option[Float] = none,
}
type OtlpAttr: Codec = { key: String, value: OtlpAttrValue }
type OtlpStatus: Codec = { code: Int }
type OtlpSpan: Codec = {
  traceId: String,
  spanId: String,
  parentSpanId: Option[String] = none,  // none = root (key omitted, proto3 unset)
  name: String,
  kind: Int,
  startTimeUnixNano: String,
  endTimeUnixNano: String,
  attributes: List[OtlpAttr],
  status: OtlpStatus,
}
type OtlpScope: Codec = { name: String, version: String }
type OtlpScopeSpans: Codec = { scope: OtlpScope, spans: List[OtlpSpan] }
type OtlpResource: Codec = { attributes: List[OtlpAttr] }
type OtlpResourceSpans: Codec = { resource: OtlpResource, scopeSpans: List[OtlpScopeSpans] }
type OtlpPayload: Codec = { resourceSpans: List[OtlpResourceSpans] }

fn attr(entry: (String, String)) -> OtlpAttr = {
  let (k, v) = entry
  OtlpAttr { key: k, value: OtlpAttrValue { stringValue: some(v) } }
}

fn span_wire(s: Span) -> OtlpSpan =
  OtlpSpan {
    traceId: s.trace_id,
    spanId: s.span_id,
    parentSpanId: s.parent_span_id,  // none stays none → key omitted on the wire
    name: s.name,
    kind: kind_code(s.kind),
    startTimeUnixNano: int.to_string(s.start_ns),
    endTimeUnixNano: int.to_string(s.end_ns),
    attributes: s.attrs |> list.map(attr),
    status: OtlpStatus { code: 1 },
  }

fn payload(t: Tracer, spans: List[Span]) -> String = {
  let doc = OtlpPayload {
    resourceSpans: [OtlpResourceSpans {
      resource: OtlpResource { attributes: [attr(("service.name", t.service))] },
      scopeSpans: [OtlpScopeSpans {
        scope: OtlpScope { name: "almide-otel", version: "0.1.0" },
        spans: spans |> list.map(span_wire),
      }],
    }],
  }
  json.stringify(OtlpPayload.encode(doc))
}

// Returns the collector's response body ({"partialSuccess":{}} = accepted)
effect fn export(t: Tracer, spans: List[Span]) -> String = {
  let headers = map.from_list([("Content-Type", "application/json")])
  let resp = http.request("POST", t.endpoint, payload(t, spans), headers)!
  resp
}
