// The SDK facade: the only module that touches the outside world.
//
// Everything impure lives here and nowhere else — the clock, the random
// ids, and the socket. `span` is pure values, `otlp` is a pure encoder,
// `w3c` is a pure header codec; none of them can be made to do IO. That
// split is what lets three quarters of this SDK be tested with plain
// value comparisons and no collector running.
//
// Layering:  span ← w3c
//            span ← otlp ← otel
//
// A service imports `otel` for the tracer, `span` for the span's own verbs,
// and `w3c` for the header. It never imports `otlp`: the wire format is an
// implementation detail of `export`.
import http
import random
import hex
import self.span
import self.otlp

let OTLP_HTTP_JSON = "http://localhost:4318/v1/traces"

type Tracer = {
  service: String,
  endpoint: String,
  // Wall-clock ns at monotonic zero. Anchor once, then derive every span
  // timestamp from the monotonic clock — datetime.now() is second-precision
  // and monotonic_ns() fills the gap. Production OTel SDKs do the same.
  anchor: Int,
}

effect fn tracer(service: String, endpoint: String = OTLP_HTTP_JSON) -> Tracer =
  Tracer {
    service: service,
    endpoint: endpoint,
    anchor: datetime.now() * 1_000_000_000 - datetime.monotonic_ns(),
  }

effect fn rand_hex(n_bytes: Int) -> String =
  list.range(0, n_bytes)
    |> list.map((_) => random.int(0, 255))
    |> bytes.from_list
    |> hex.encode

effect fn now_ns(t: Tracer) -> Int = t.anchor + datetime.monotonic_ns()

// `parent: none` opens a new trace; `parent: some(ctx)` continues one. The
// Option is the whole difference between the two, so it stays here and the
// two entry points below spell it out by name instead of making every call
// site write `none`.
effect fn start(t: Tracer, name: String, kind: span.SpanKind, parent: Option[span.SpanCtx]) -> span.Span =
  span.Span {
    trace_id: match parent { some(c) => c.trace_id, none => rand_hex(16)! },
    span_id: rand_hex(8)!,
    parent_span_id: match parent { some(c) => some(c.span_id), none => none },
    name: name,
    kind: kind,
    start_ns: now_ns(t)!,
    end_ns: 0,
    attrs: [],
    status: span.Unset,
  }

// Opens a new trace. `kind` defaults to Internal — what a root span in a
// one-shot program almost always is.
effect fn root(t: Tracer, name: String, kind: span.SpanKind = span.Internal) -> span.Span =
  start(t, name, kind, none)!

// Continues the caller's trace. Taking a SpanCtx rather than an Option is
// the point: a child without a parent is unwritable.
effect fn child(t: Tracer, parent: span.SpanCtx, name: String, kind: span.SpanKind) -> span.Span =
  start(t, name, kind, some(parent))!

// The one step that stamps the clock, and therefore the one span verb that
// is not in `span`. It takes the span first so it can end a `|>` chain.
effect fn finish(s: span.Span, t: Tracer) -> span.Span = { ...s, end_ns: now_ns(t)! }

// Returns the collector's response body ({"partialSuccess":{}} = accepted).
effect fn export(t: Tracer, spans: List[span.Span]) -> String =
  http.request("POST", t.endpoint, otlp.payload(t.service, spans),
    ["Content-Type": "application/json"])!

// ── Tests ───────────────────────────────────────────────────────────────
// A test block may call effect fns directly, so the id and parenting rules
// are checkable here even though they need the clock and the RNG. The wire
// is not retested — that is `otlp`'s job.

test "ids are the widths OTLP requires" {
  let t = tracer("svc", "")!
  assert_eq(string.len(rand_hex(16)!), 32)  // trace id: 16 bytes
  assert_eq(string.len(rand_hex(8)!), 16)   // span id:   8 bytes
  assert_eq(string.len(root(t, "n")!.trace_id), 32)
}

// The defaulted parameters are part of the surface, so they are exercised:
// `tracer` without an endpoint and `root` without a kind.
test "the defaults are the common case" {
  let t = tracer("svc")!
  assert_eq(t.endpoint, OTLP_HTTP_JSON)
  assert_eq("${root(t, "n")!.kind}", "internal")
}

test "a root opens a trace; a child continues it" {
  let t = tracer("svc", "")!
  let r = root(t, "parent", span.Server)!
  let c = child(t, span.ctx(r), "kid", span.Client)!
  assert_eq(r.parent_span_id, none)
  assert_eq(c.parent_span_id, some(r.span_id))
  assert_eq(c.trace_id, r.trace_id)       // same trace
  assert(c.span_id != r.span_id)          // distinct spans
}

test "two roots do not share a trace" {
  let t = tracer("svc", "")!
  assert(root(t, "a", span.Internal)!.trace_id != root(t, "b", span.Internal)!.trace_id)
}

// end_ns stays 0 until `finish`, so an unfinished span is distinguishable
// from a zero-length one rather than silently reported as instantaneous.
test "finish is what stamps the end" {
  let t = tracer("svc", "")!
  let s = root(t, "n", span.Internal)!
  assert_eq(s.end_ns, 0)
  assert(finish(s, t)!.end_ns >= s.start_ns)
}
