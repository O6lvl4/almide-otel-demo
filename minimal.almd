// Minimal single-file version: one span, no SDK — shows the raw
// OTLP/HTTP JSON shape Jaeger accepts on localhost:4318.
import json
import http
import random
import process

effect fn rand_bytes(n: Int) -> List[Int] =
  if n == 0 then ([]: List[Int])
  else [random.int(0, 255)] + rand_bytes(n - 1)!

effect fn rand_hex(n_bytes: Int) -> String =
  rand_bytes(n_bytes)! |> bytes.from_list |> hex.encode

fn attr_str(key: String, val: String) -> Value =
  json.object([
    ("key", json.from_string(key)),
    ("value", json.object([("stringValue", json.from_string(val))])),
  ])

fn span_json(trace_id: String, span_id: String, name: String, start_ns: Int, end_ns: Int) -> Value =
  json.object([
    ("traceId", json.from_string(trace_id)),
    ("spanId", json.from_string(span_id)),
    ("name", json.from_string(name)),
    ("kind", json.from_int(1)),
    ("startTimeUnixNano", json.from_string(int.to_string(start_ns))),
    ("endTimeUnixNano", json.from_string(int.to_string(end_ns))),
    ("attributes", json.array([attr_str("language", "almide")])),
    ("status", json.object([("code", json.from_int(1))])),
  ])

fn payload(service: String, span: Value) -> String = {
  let resource = json.object([
    ("attributes", json.array([attr_str("service.name", service)])),
  ])
  let scope = json.object([
    ("name", json.from_string("almide-otel")),
    ("version", json.from_string("0.1.0")),
  ])
  let scope_spans = json.object([
    ("scope", scope),
    ("spans", json.array([span])),
  ])
  let resource_spans = json.object([
    ("resource", resource),
    ("scopeSpans", json.array([scope_spans])),
  ])
  json.stringify(json.object([("resourceSpans", json.array([resource_spans]))]))
}

effect fn main() -> Unit = {
  // Anchor wall clock once, derive ns-precision timestamps from the monotonic clock
  let anchor = datetime.now() * 1000000000 - datetime.monotonic_ns()

  let trace_id = rand_hex(16)
  let span_id = rand_hex(8)

  let start_ns = anchor + datetime.monotonic_ns()
  process.sleep(42)
  let end_ns = anchor + datetime.monotonic_ns()

  let body = payload("almide-spike", span_json(trace_id, span_id, "spike-root", start_ns, end_ns))
  let headers = map.from_list([("Content-Type", "application/json")])
  let resp = http.request("POST", "http://localhost:4318/v1/traces", body, headers)!
  println("exporter response: ${resp}")
  println("trace_id: ${trace_id}")
}
